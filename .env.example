# DISHAA Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/dishaa_db

# Valhalla Routing Engine Base URL
VALHALLA_URL=http://localhost:8002

# Express Server Port
PORT=3000

# Ollama local model runtime
# Example local Ollama configuration. Copy to .env and set real values there.
OLLAMA_BASE_URL=http://localhost:11434
# Recommended local model (example): qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=20000

# Application Environment
NODE_ENV=development
