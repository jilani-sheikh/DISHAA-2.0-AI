# DISHAA Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/dishaa_db

# Valhalla Routing Engine Base URL
VALHALLA_URL=http://localhost:8002

# Express Server Port
PORT=3000

# Application Environment
NODE_ENV=development

# ─── AI Provider Configuration ────────────────────────────────────────────────
# Active conversational provider: 'gemini' (default, recommended) or 'ollama' (legacy)
AI_PROVIDER=gemini

# Google Gemini API
# Server-side API key (never expose to frontend or git)
GEMINI_API_KEY=
# Configurable Flash-class Gemini model for low latency streaming
# Options: gemini-flash-lite-latest, gemini-3.7-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=15000

# Ollama local model runtime (optional fallback / legacy provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=20000